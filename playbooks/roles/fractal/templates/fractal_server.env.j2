# Managed by the fractal SRC component — bind-mounted over
# /.fractal_server.env. Templated rather than set through the compose
# override's "environment:", because fractalctl reads this file as a dotenv
# and it is not reliable which of the two wins.
FRACTAL_RUNNER_BACKEND=slurm_sudo

# Every service in this stack runs with network_mode: host, so the database is
# on localhost rather than on a compose service name.
POSTGRES_HOST=localhost
POSTGRES_USER=fractal
POSTGRES_PASSWORD=fractal
POSTGRES_PORT=5433
POSTGRES_DB=fractal

# Generated once by the role and reused on every later run. Upstream ships a
# placeholder here; on an internet-facing workspace that would let anyone mint
# valid tokens.
JWT_SECRET_KEY={{ fractal_jwt_secret }}
JWT_EXPIRE_SECONDS=84600

FRACTAL_LOGGING_LEVEL=20
FRACTAL_DEFAULT_GROUP_NAME=All
