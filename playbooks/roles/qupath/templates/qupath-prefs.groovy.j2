// Run headless once per user by /etc/runonce.d/setup-qupath.sh. Written by
// Ansible. Only fills in preferences the user has not set.
import qupath.lib.gui.prefs.PathPrefs

if (PathPrefs.userPathProperty().get() == null)
    PathPrefs.userPathProperty().set("{{ qupath_common_data_dir }}")

// The cellpose extension (0.11) reads these; cellposeSAMPythonPath is for cpsam.
def python = new File("{{ qupath_pixi_envs_dir }}/cellpose/.pixi/envs/default/bin/python")
def prefs = PathPrefs.getUserPreferences()
if (python.canExecute()) {
    for (key in ["cellposePythonPath", "cellposeSAMPythonPath"]) {
        if (prefs.get(key, "").isEmpty())
            prefs.put(key, python.getPath())
    }
}
prefs.flush()
