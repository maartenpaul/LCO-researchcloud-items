#!/bin/bash
# ai-tools-lab — start JupyterLab from inside the desktop session.
#
# The desktop flavour of a workspace has no Lab entry point at all, and even on
# a JupyterHub workspace there is nothing to click inside the desktop itself.
#
# Which Lab: the workspace's own venv if SRC installed one, otherwise the
# dedicated "jupyterlab" environment in the shared checkout, which is where the
# Lab extensions (jupyterlab-git, nbdime) live. The host barely matters — the
# pixi kernels are registered system-wide in /usr/local/share/jupyter/kernels,
# so any Lab on this machine sees all of them.
#
# The last resort is any tool environment that happens to ship jupyter-lab.
# That used to be the only rule, and it made the answer depend on collation:
# under LANG=C.UTF-8 the glob starts at CAREamics, under en_US.UTF-8 at biapy,
# so which Lab — and therefore which extensions — a user got varied with the
# session locale. LC_ALL=C at least makes the fallback deterministic.
#
# Lab is always rooted at $HOME. Starting it from inside a tool directory would
# root the file browser in /opt/AI_tools_pixi, which is read-only for users, so
# nothing could be saved and every new notebook would fail.

set -euo pipefail

SHARED_DIR="${SHARED_DIR:-/opt/AI_tools_pixi}"
SRC_VENV_LAB="${SRC_VENV_LAB:-/etc/src/venv/jupyter-venv/bin/jupyter-lab}"
LAB_ENV="${LAB_ENV:-jupyterlab}"

find_lab() {
    if [ -x "${SRC_VENV_LAB}" ]; then
        echo "${SRC_VENV_LAB}"
        return 0
    fi
    shared_lab="${SHARED_DIR}/${LAB_ENV}/.pixi/envs/default/bin/jupyter-lab"
    if [ -x "${shared_lab}" ]; then
        echo "${shared_lab}"
        return 0
    fi
    # The glob is sorted by the shell's own collation, so LC_ALL is set here,
    # in the subshell that expands it, rather than around a command.
    fallback=$(
        LC_ALL=C
        for env_lab in "${SHARED_DIR}"/*/.pixi/envs/default/bin/jupyter-lab; do
            if [ -x "${env_lab}" ]; then
                echo "${env_lab}"
                break
            fi
        done
    )
    if [ -n "${fallback}" ]; then
        echo "${fallback}"
        return 0
    fi
    return 1
}

if ! lab=$(find_lab); then
    msg="No JupyterLab found on this workspace."
    # In a desktop session a failure that only prints to a closed terminal is
    # invisible, so say it in a dialog when one is available.
    if command -v zenity >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
        zenity --error --no-wrap --text "${msg}"
    fi
    echo "${msg}" >&2
    exit 1
fi

# Anything passed to this script is handed to Lab, so it can still be run by
# hand with extra options. root_dir comes first so an explicit one wins.
exec "${lab}" --ServerApp.root_dir="${HOME}" "$@"
