#!/bin/bash
# ai-tools-gui — run a GUI application from a shared Pixi AI tool environment.
#
# Intended for the remote desktop: the XFCE menu entries this component installs
# all call it. It can also be run from a terminal inside the desktop session.
#
# Two things it adds over a bare "pixi run":
#
#   1. It runs through `ai-tools run`, the same as the Jupyter kernels, so the
#      menu entry and the kernel use the same environment — the user's own
#      copy when there is one. A napari plugin installed with "%pip install"
#      in a notebook is therefore also there when napari is opened from the
#      menu.
#   2. OpenGL is routed to the GPU through VirtualGL when that is possible.
#      TigerVNC's own GL is llvmpipe, i.e. software. That is fast enough for 2D
#      images but not for volume rendering: a 256^3 MIP rotation in napari
#      measured ~114 ms/frame on llvmpipe against ~16 ms/frame through vglrun.
#
# Usage: ai-tools-gui <tool> [command ...]     (default command: the tool name)

set -euo pipefail

AI_TOOLS="${AI_TOOLS:-/usr/local/bin/ai-tools}"
VGLRUN="${VGLRUN:-/opt/VirtualGL/bin/vglrun}"

if [ $# -lt 1 ]; then
    echo "Usage: ai-tools-gui <tool> [command ...]" >&2
    echo "Run 'ai-tools list' to see the available tools." >&2
    exit 2
fi

tool="$1"
shift

# No command given: run the program that shares the tool's name.
[ $# -gt 0 ] || set -- "${tool}"

run=("${AI_TOOLS}" run "${tool}" "$@")

# VirtualGL is only useful on a real display and only with an NVIDIA device for
# its EGL back end. Without either, run it directly — Qt still
# works, it just renders in software.
if [ -n "${DISPLAY:-}" ] && [ -x "${VGLRUN}" ] && [ -c /dev/nvidiactl ]; then
    exec "${VGLRUN}" -d "${VGL_EGL_DEVICE:-egl}" "${run[@]}"
fi

exec "${run[@]}"
