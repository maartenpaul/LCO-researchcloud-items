# Direct HTTPS access to OMERO.web — no SRAM authentication, visitors land
# on OMERO's own login page. Reuses the workspace certificate that the SRC
# nginx component obtained (paths detected from the live nginx config).
# Managed by the omero SRC component — re-running the component overwrites
# this file.
#
# To toggle on a live workspace: remove or restore this file, run
# "nginx -s reload", and close or open port {{ omero_direct_port }} in the
# workspace security group via the SRC dashboard.
server {
    listen {{ omero_direct_port }} ssl;
{% if omero_listen_ipv6 | bool %}
    listen [::]:{{ omero_direct_port }} ssl;
{% endif %}
    server_name {{ omero_workspace_fqdn }};

    ssl_certificate {{ omero_tls_cert }};
    ssl_certificate_key {{ omero_tls_key }};
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:{{ omero_web_port }};
        proxy_redirect http://127.0.0.1:{{ omero_web_port }}/ $scheme://$host:$server_port/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300;
    }
}
